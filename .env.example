# Public site URL (used for sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.inmedicadevices.com

# MongoDB (Atlas or self-hosted). Enquiries are stored in the "enquiries" collection.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/inmedica?retryWrites=true&w=majority

# SMTP for enquiry emails — Gmail with an App Password. Gmail only sends "from" the account itself.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=inmedicadevices@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
# Fallback only: recipients are set in the admin (Settings → Email notifications).
ENQUIRY_TO=inmedicadevices@gmail.com
ENQUIRY_FROM="InMedica Devices <inmedicadevices@gmail.com>"

# Shared secret with the admin portal (admin.inmedicadevices.com). The admin uses it to
# refresh the website after every change and to sign preview links. Use the SAME value
# in both Vercel projects. Any long random string.
REVALIDATE_SECRET=change-me-to-a-long-random-string
